# ── API keys ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Database ───────────────────────────────────────────────────────────────────
DB_PATH=monitoring_ai.db

# ── Config file (optional) ─────────────────────────────────────────────────────
# Point to a different YAML to switch between environments:
#   CONFIG_PATH=config.prod.yaml
# CONFIG_PATH=config.yaml

# ── Prompts directory (optional) ───────────────────────────────────────────────
# PROMPTS_DIR=/absolute/path/to/prompts

# ── Environment tag (used in LangSmith trace metadata) ────────────────────────
APP_ENV=dev

# ── LangSmith tracing (optional — remove or set to false to disable) ───────────
# Sign up at https://smith.langchain.com to get an API key.
# Traces are sent only when LANGCHAIN_TRACING_V2=true.
#
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=monitoring_ai_dev   # use a different project per environment
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com  # default, rarely needs changing
