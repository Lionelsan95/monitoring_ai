# ── LLM provider API keys ─────────────────────────────────────────────────────
# Only the key for the provider configured in config.yaml is required.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Ollama (local / docker-compose) ───────────────────────────────────────────
# Base URL of the Ollama server. Defaults to localhost for bare-metal use.
# docker-compose sets this to http://ollama:11434 automatically.
# OLLAMA_BASE_URL=http://localhost:11434

# ── Database ───────────────────────────────────────────────────────────────────
# Absolute or relative path. Defaults to <project_root>/monitoring_ai.db.
# docker-compose sets this to /app/data/monitoring_ai.db (named volume).
# DB_PATH=monitoring_ai.db

# ── Config file ────────────────────────────────────────────────────────────────
# Path to the YAML model config. Defaults to <project_root>/config.yaml.
# Use config/ollama.yaml for local Ollama, config/bedrock.yaml for AWS Bedrock.
# CONFIG_PATH=config.yaml
# CONFIG_PATH=config/ollama.yaml

# ── Prompts directory (optional) ───────────────────────────────────────────────
# Defaults to <project_root>/prompts/. Override only if moving prompt files.
# PROMPTS_DIR=/absolute/path/to/prompts

# ── Environment tag ────────────────────────────────────────────────────────────
# Attached to LangSmith trace metadata.
APP_ENV=dev

# ── LangSmith tracing (optional) ──────────────────────────────────────────────
# Traces are sent only when LANGCHAIN_TRACING_V2=true.
# Sign up at https://smith.langchain.com to get an API key.
#
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=monitoring_ai_dev
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── AWS (Terraform / CI/CD) ────────────────────────────────────────────────────
# Used by the push-ecr CI job and Terraform. Not needed for local dev.
# AWS_REGION=eu-west-1
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/github-actions-role
# ECR_REPOSITORY=monitoring-ai
